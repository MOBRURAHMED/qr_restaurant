# ==============================================================================
# MULTI-RESTAURANT QR SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Populate with your Supabase and Razorpay test credentials.
# 3. NEVER commit real production keys, secret keys, or service role credentials.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose in NEXT_PUBLIC_*)
# Used for backend webhooks, authoritative order mutations, and background tasks
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain these from Razorpay Dashboard -> Settings -> API Keys
# Default platform keys (individual restaurants may also configure sub-merchant credentials)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Webhooks)
# Used to verify HMAC-SHA256 signatures for payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
